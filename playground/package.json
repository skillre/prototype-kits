    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kits/animated-grid": "workspace:*",
    "@kits/contracts": "workspace:*",
    "@kits/data-cursor": "workspace:*",
    "@kits/effects": "workspace:*",
    "@kits/insight-reveal": "workspace:*",
    "@kits/interactive-hero": "workspace:*",
    "@kits/react-utils": "workspace:*",
    "@kits/spotlight-surface": "workspace:*",
    "@kits/style-cinematic": "workspace:*",
    "@kits/style-console": "workspace:*",
    "@kits/style-editorial": "workspace:*",
    "@kits/style-instrument": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
