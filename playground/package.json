{
  "name": "@kits/playground",
  "version": "0.2.0",
  "private": true,
  "description": "Prototype Kits · Visual Playground —— registry 里全部已批准的 Style Pack 并排 + 五个 Signature Component 验收 + Registry 审计。不是业务产品。",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
