{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-kits.local/schemas/registry.schema.json",
  "title": "Prototype Kits Asset Registry",
  "description": "registry/assets.json 的结构契约。任何资产在没有通过这里的校验之前，都不得被 Prototype 引用。",
  "type": "object",
  "required": [
    "registryVersion",
    "statusLifecycle",
    "policy",
    "assets"
  ],
  "additionalProperties": true,
  "properties": {
    "registryVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "statusLifecycle": {
      "type": "array",
      "items": {
        "enum": [
          "incoming",
          "experimental",
          "approved",
          "deprecated"
        ]
      },
      "minItems": 4
    },
    "policy": {
      "type": "object",
      "required": [
        "approvalRequired",
        "forbidden"
      ],
      "properties": {
        "approvalRequired": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "assetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "incoming",
        "experimental",
        "approved",
        "deprecated"
      ]
    },
    "performanceClass": {
      "description": "A = 静态 CSS；B = 合成友好但有滤镜/混合成本；C = 需要 JS 持续驱动",
      "enum": [
        "A",
        "B",
        "C",
        "not-applicable"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "origin",
        "license",
        "containsThirdPartyCode"
      ],
      "properties": {
        "kind": {
          "enum": [
            "first-party",
            "external",
            "derived"
          ]
        },
        "origin": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "containsThirdPartyCode": {
          "type": "boolean"
        },
        "inspiration": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "comment": "外部/派生资产必须写明许可证与来源；first-party 也必须写明 license 字段（可以是 UNLICENSED (internal)）",
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "external",
                  "derived"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "license"
            ],
            "properties": {
              "license": {
                "type": "string",
                "not": {
                  "const": ""
                },
                "description": "外部资产禁止留空、禁止写 unknown/to-check"
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "status",
        "version",
        "path",
        "dependencies",
        "performance",
        "ssrCompatible",
        "mobileCompatible",
        "reducedMotion",
        "source"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/assetId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "style",
            "component",
            "effect",
            "skill",
            "package"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "apiVersion": {
          "type": "string",
          "description": "仅组件/技能有此字段；产品只依赖 major",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "contractVersion": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry": {
          "type": "string"
        },
        "cssEntry": {
          "type": "string"
        },
        "demo": {
          "type": "string"
        },
        "readme": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "运行时依赖的其它资产 id 或包名；空数组表示零依赖"
        },
        "thirdPartyRuntime": {
          "type": "string"
        },
        "bundleSize": {
          "type": "string"
        },
        "performance": {
          "$ref": "#/$defs/performanceClass"
        },
        "performanceNotes": {
          "type": "string"
        },
        "ssrCompatible": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "mobileCompatible": {
          "$ref": "#/$defs/mobileCompatibility"
        },
        "reducedMotion": {
          "enum": [
            "supported",
            "not-applicable",
            "unsupported"
          ],
          "description": "unsupported 的资产不得进入 approved"
        },
        "a11yNotes": {
          "type": "string"
        },
        "adapterRequired": {
          "type": "boolean"
        },
        "adapterWorkedExample": {
          "type": "string"
        },
        "signatureComponents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetId"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "recommendedFor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fitTag"
          },
          "description": "适配维度标签（枚举）。人读的散文见 recommendedForNotes。"
        },
        "avoidFor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fitTag"
          },
          "description": "适配维度标签（枚举）。人读的散文见 avoidForNotes。同一个值不允许同时出现在 recommendedFor 与 avoidFor。"
        },
        "recommendedForNotes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "recommendedFor 对应的人读散文（迁移自 v0.1.1 的自由文本），与标签一一对应。"
        },
        "avoidForNotes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "avoidFor 对应的人读散文（迁移自 v0.1.1 的自由文本），与标签一一对应。"
        },
        "darkDirection": {
          "$ref": "#/$defs/darkDirection"
        },
        "materialDirection": {
          "$ref": "#/$defs/materialDirection"
        },
        "material": {
          "$ref": "#/$defs/effectMaterial"
        }
      },
      "allOf": [
        {
          "comment": "style 资产必须带 selector 与 cssEntry",
          "if": {
            "properties": {
              "type": {
                "const": "style"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "selector",
              "cssEntry",
              "contractVersion"
            ]
          }
        },
        {
          "comment": "component 资产必须带 apiVersion 与 manifest",
          "if": {
            "properties": {
              "type": {
                "const": "component"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "apiVersion",
              "manifest",
              "demo",
              "readme"
            ]
          }
        }
      ]
    },
    "fitTag": {
      "description": "产品适配维度（有限枚举）。recommendedFor / avoidFor 只接受这里的值，或 x- 前缀的扩展命名空间 —— 不允许自由字符串（typo 必须失败）。每个值的定义见 registry/README.md 的「适配维度」表。",
      "oneOf": [
        {
          "enum": [
            "mobile",
            "desktop",
            "touch",
            "pointer",
            "high-density",
            "low-density",
            "data-heavy",
            "text-heavy",
            "motion-sensitive",
            "accessibility-critical"
          ]
        },
        {
          "type": "string",
          "pattern": "^x-[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ]
    },
    "packRole": {
      "description": "组件在某套 Style Pack 里的角色。与 pack manifest 的 signatureComponents / optionalComponents / discouragedComponents **一一对应**：角色词写 signature，就必须出现在那套 pack 的 signatureComponents 里。这不是审美标签 —— 两边不一致时，产品按哪一边决策都是错的。",
      "enum": [
        "signature",
        "optional",
        "discouraged"
      ]
    },
    "usedByStylePacks": {
      "description": "组件自己声明的「我在哪几套 pack 里担任什么角色」。key = pack id，value = 角色词开头（后面可以跟括号里的说明文字，例如 `signature（64px + 55% 淡出）`）—— **只有开头那个词是契约**。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^(signature|optional|discouraged)(\\s|\\(|（|$)"
      }
    },
    "mobileFallback": {
      "description": "mobileCompatible = \"fallback-only\" 时**必须**存在：触屏上到底发生什么，以及为什么不是内容损失。trigger 是触发条件，behavior 是逐条可核对的降级行为（不是形容词），noContentLoss 必须为 true。",
      "type": "object",
      "required": [
        "trigger",
        "behavior",
        "noContentLoss"
      ],
      "additionalProperties": true,
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "behavior": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "noContentLoss": {
          "const": true,
          "description": "必须为 true：降级不等于丢信息。false 的组件不得声明 fallback-only"
        }
      }
    },
    "mobileCompatibility": {
      "description": "**兼容性，不是推荐。** true = 在它自己声明的支持条件下允许在移动 viewport 使用，不会因为 API / layout 假设而天然失效；它**不**表示 recommended for mobile、ideal for high density、should appear on mobile 或 no adaptation needed。false = 不得在移动 viewport 使用。\"fallback-only\" = 只能在它声明的 mobileFallback 行为下使用（能力本身在触屏上不激活，但没有内容损失）。\"not-applicable\" = 非视觉资产（skill / package）。推荐与否请看 recommendedFor / avoidFor，两者是不同维度。",
      "enum": [
        true,
        false,
        "fallback-only",
        "not-applicable"
      ]
    },
    "darkStrategy": {
      "description": "这套 pack 的暗色方向从哪来。single-theme = pack 原生就是单一主题（例如原生深色），暗色等于原生；pack-authored = pack 自己带暗色取值；product-authored = pack 不带，产品按 approach + contrastTarget 自己写覆盖 —— 这是被契约明确允许的（颜色是唯一允许覆盖的维度）。",
      "enum": [
        "single-theme",
        "pack-authored",
        "product-authored"
      ]
    },
    "darkApproach": {
      "description": "strategy = product-authored 时的覆盖方向。preserve-hue = 保留色相、只反转明度（颜色承担语义的 pack 必须走这条：反转色相会毁掉语义）；invert-contrast = 画布/墨色角色对调（近灰阶的 pack 适用）。",
      "enum": [
        "preserve-hue",
        "invert-contrast"
      ]
    },
    "contrastTarget": {
      "description": "Product 写暗色覆盖时必须达到的对比度目标（可执行，不是审美形容词）。",
      "type": "object",
      "required": [
        "standard",
        "normalText",
        "largeText"
      ],
      "additionalProperties": false,
      "properties": {
        "standard": {
          "enum": [
            "WCAG-AA",
            "WCAG-AAA"
          ],
          "description": "WCAG-AA = 正文 4.5:1 / 大字 3:1；WCAG-AAA = 7:1 / 4.5:1"
        },
        "normalText": {
          "type": "number",
          "minimum": 4.5,
          "maximum": 21,
          "description": "正文对比度下限；AA 为 4.5，低于它一律非法"
        },
        "largeText": {
          "type": "number",
          "minimum": 3,
          "maximum": 21,
          "description": "大字（≥24px 或 ≥19px bold）对比度下限；AA 为 3"
        }
      }
    },
    "darkDirection": {
      "description": "Style Pack 的暗色方向指引。**可选**：没有它就是「未声明」，是合法的旧状态（audit 会说出来，而不是静默当作没有暗色问题）。Kits 不强制每个 pack 都产出第二套完整调色板 —— 它要求「如果声明了，就要能被校验」。",
      "type": "object",
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "$ref": "#/$defs/darkStrategy"
        },
        "approach": {
          "$ref": "#/$defs/darkApproach"
        },
        "contrastTarget": {
          "$ref": "#/$defs/contrastTarget"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^--kits-[a-z0-9-]+$"
          },
          "description": "允许产品覆盖的槽位（CSS 自定义属性名）。必须是该 pack 的 tokens.css 里真实声明的变量 —— typo 一律失败。"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "comment": "product-authored 必须给出 approach + contrastTarget + slots —— 否则产品没有可执行的方向",
          "if": {
            "properties": {
              "strategy": {
                "const": "product-authored"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "required": [
              "approach",
              "contrastTarget",
              "slots"
            ]
          }
        }
      ]
    },
    "materialHierarchy": {
      "description": "这套 pack 用什么建立层级（v0.2 · K8 的「材质语言」）。light = 用光与明暗分层（cinematic：一束光把容器从背景里托起来）；rule = 用线与边界分格（instrument：1px 实线）；space = 用留白与间距（editorial：间距大于任何控件尺寸）；texture = 用表面材质本身（纸、网点）。**这是声明，不是断言** —— 它给 agent 与人读，判定不去猜审美；能被机器核对的字段见 materialAmbient / materialGlow。",
      "enum": [
        "light",
        "rule",
        "space",
        "texture"
      ]
    },
    "materialAmbient": {
      "description": "环境光（ambient）归谁 —— 这一条**可以从 CSS 核对**，不是形容词。pack-authored = pack 自己带一层环境光，必须在自己的 tokens.css 里定义 `.kits-ambient`（cinematic）；effect-only = pack 不带，环境光只能来自显式安装的 Effect Pack（ambient-glow）；none = 这套 pack 的材质语言里没有环境光（editorial / instrument），此时它的 CSS 里不得出现 `.kits-ambient`。",
      "enum": [
        "pack-authored",
        "effect-only",
        "none"
      ]
    },
    "materialGlow": {
      "description": "发光预算 —— 同样**可从 CSS 核对**：pack 的 `--kits-color-glow` 是透明还是真颜色。budgeted = 允许发光（cinematic：glow 是真实颜色，且自己规定「同屏发光元素 ≤ 1」）；forbidden = 不允许（editorial / instrument：`--kits-color-glow: transparent`）。与 effects[] 交叉核对：声明 forbidden 的 pack 不允许登记发光的 effect。",
      "enum": [
        "budgeted",
        "forbidden"
      ]
    },
    "materialDirection": {
      "description": "Style Pack 的**材质语言**（v0.2 · K8）。**可选**：不声明 = 合法旧状态（audit 报 info）。目的不是把 CSS token 搬进 JSON，而是机器可读地回答「这套 pack 的材质性格是什么」。三个字段里 ambient 与 glow 可以被核对（CSS / effects[] 交叉），hierarchy 是声明。**不包含任何 mobile 字段**：移动端语义一律走 K2 的 mobileCompatible / mobileFallback，不在这里造第二套。",
      "type": "object",
      "required": [
        "hierarchy",
        "ambient",
        "glow"
      ],
      "additionalProperties": false,
      "properties": {
        "hierarchy": {
          "$ref": "#/$defs/materialHierarchy"
        },
        "ambient": {
          "$ref": "#/$defs/materialAmbient"
        },
        "glow": {
          "$ref": "#/$defs/materialGlow"
        },
        "notes": {
          "type": "string",
          "description": "人读的一句话：这套材质语言为什么是这样。"
        }
      }
    },
    "effectMaterialKind": {
      "description": "Effect Pack 在材质层面的类别。light = 它画的是光（因此会与 pack 的发光预算、环境光归属发生关系）；texture = 它画的是表面材质（噪点、纸纹）；line = 它画的是线（刻度、扫描线）。字段少是刻意的：这是三个 effect 的反推，不是待填的目录。",
      "enum": [
        "light",
        "texture",
        "line"
      ]
    },
    "effectMaterial": {
      "description": "Effect Pack 的材质类别声明（写在该 effect 于 effects/manifest.json 的节点上，可选）。它让 pack 的 materialDirection 与 effect 之间可以**交叉核对**：声明 `ambient: none` 或 `glow: forbidden` 的 pack 不允许把 light 类 effect 写进自己的 effects[]。",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/effectMaterialKind"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
