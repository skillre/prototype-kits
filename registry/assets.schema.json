{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-kits.local/schemas/registry.schema.json",
  "title": "Prototype Kits Asset Registry",
  "description": "registry/assets.json 的结构契约。任何资产在没有通过这里的校验之前，都不得被 Prototype 引用。",
  "type": "object",
  "required": ["registryVersion", "statusLifecycle", "policy", "assets"],
  "additionalProperties": true,
  "properties": {
    "registryVersion": { "type": "string" },
    "generatedAt": { "type": "string" },
    "description": { "type": "string" },
    "statusLifecycle": {
      "type": "array",
      "items": { "enum": ["incoming", "experimental", "approved", "deprecated"] },
      "minItems": 4
    },
    "policy": {
      "type": "object",
      "required": ["approvalRequired", "forbidden"],
      "properties": {
        "approvalRequired": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "forbidden": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "assetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "enum": ["incoming", "experimental", "approved", "deprecated"]
    },
    "performanceClass": {
      "description": "A = 静态 CSS；B = 合成友好但有滤镜/混合成本；C = 需要 JS 持续驱动",
      "enum": ["A", "B", "C", "not-applicable"]
    },
    "source": {
      "type": "object",
      "required": ["kind", "origin", "license", "containsThirdPartyCode"],
      "properties": {
        "kind": { "enum": ["first-party", "external", "derived"] },
        "origin": { "type": "string" },
        "license": { "type": "string" },
        "containsThirdPartyCode": { "type": "boolean" },
        "inspiration": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "comment": "外部/派生资产必须写明许可证与来源；first-party 也必须写明 license 字段（可以是 UNLICENSED (internal)）",
          "if": { "properties": { "kind": { "enum": ["external", "derived"] } }, "required": ["kind"] },
          "then": {
            "required": ["license"],
            "properties": {
              "license": {
                "type": "string",
                "not": { "const": "" },
                "description": "外部资产禁止留空、禁止写 unknown/to-check"
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "status",
        "version",
        "path",
        "dependencies",
        "performance",
        "ssrCompatible",
        "mobileCompatible",
        "reducedMotion",
        "source"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/assetId" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["style", "component", "effect", "skill"] },
        "status": { "$ref": "#/$defs/status" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "apiVersion": {
          "type": "string",
          "description": "仅组件/技能有此字段；产品只依赖 major",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "contractVersion": { "type": "string" },
        "path": { "type": "string" },
        "manifest": { "type": ["string", "null"] },
        "entry": { "type": "string" },
        "cssEntry": { "type": "string" },
        "demo": { "type": "string" },
        "readme": { "type": "string" },
        "selector": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "运行时依赖的其它资产 id 或包名；空数组表示零依赖"
        },
        "thirdPartyRuntime": { "type": "string" },
        "bundleSize": { "type": "string" },
        "performance": { "$ref": "#/$defs/performanceClass" },
        "performanceNotes": { "type": "string" },
        "ssrCompatible": { "type": ["boolean", "string"] },
        "mobileCompatible": { "type": ["boolean", "string"] },
        "reducedMotion": {
          "enum": ["supported", "not-applicable", "unsupported"],
          "description": "unsupported 的资产不得进入 approved"
        },
        "a11yNotes": { "type": "string" },
        "adapterRequired": { "type": "boolean" },
        "adapterWorkedExample": { "type": "string" },
        "signatureComponents": { "type": "array", "items": { "$ref": "#/$defs/assetId" } },
        "source": { "$ref": "#/$defs/source" }
      },
      "allOf": [
        {
          "comment": "style 资产必须带 selector 与 cssEntry",
          "if": { "properties": { "type": { "const": "style" } }, "required": ["type"] },
          "then": { "required": ["selector", "cssEntry", "contractVersion"] }
        },
        {
          "comment": "component 资产必须带 apiVersion 与 manifest",
          "if": { "properties": { "type": { "const": "component" } }, "required": ["type"] },
          "then": { "required": ["apiVersion", "manifest", "demo", "readme"] }
        }
      ]
    }
  }
}
