{
  "name": "prototype-kits",
  "version": "0.2.0",
  "private": true,
  "description": "Prototype Factory · 可插拔视觉与能力资产库 (Style Packs / Signature Components / Effects / Skills / References)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter @kits/playground typecheck && tsc --noEmit -p tsconfig.kits.json",
    "test": "vitest run",
    "build": "pnpm --filter @kits/playground build",
    "dev": "pnpm --filter @kits/playground dev",
    "check": "pnpm factory:agents && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "factory:agents": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/guard-agent-policy.mjs",
    "qa": "node scripts/check-qa-port.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON .qa/kits-shots.mjs",
    "registry": "node scripts/registry-audit.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "qa:reveal": "node scripts/check-qa-port.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON .qa/reveal-probe.mjs"
  },
  "devDependencies": {
    "@kits/contracts": "workspace:*",
    "@kits/react-utils": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}
